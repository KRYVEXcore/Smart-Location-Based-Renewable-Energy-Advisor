# Copy this file to backend/.env for local backend development, and
# frontend/.env for the frontend (using the VITE_-prefixed equivalent).
# See frontend/.env.example for the frontend's own variable.
# NEVER commit a real .env file — it is already listed in .gitignore.

# PostgreSQL connection string used by the backend (SQLAlchemy).
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/renewable_energy_advisor

# Base URL where the backend API is served. The frontend needs this as
# VITE_API_BASE_URL (see frontend/.env.example) since Vite only exposes
# variables prefixed with VITE_ to client-side code.
API_BASE_URL=http://localhost:8000

# development | staging | production
APP_ENV=development

# Used for future authentication/session signing. Generate a real random
# value for any non-local environment — never reuse this placeholder.
SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# SHREA AI advisor (Phase 8). NVIDIA NIM (OpenAI-compatible API). The key is
# backend-only: never put it in frontend/.env, GitHub Pages variables or Git.
# Leave NVIDIA_API_KEY empty and the advisor reports "not connected" instead of answering.
AI_PROVIDER=nvidia_nim
AI_MODEL=nvidia/nemotron-nano-3-30b-a3b
NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# Location intelligence providers (Phase 3)
#
# All of these are OPTIONAL. Every one already defaults to a free, keyless
# provider (Nominatim, NASA POWER, Open-Elevation) — the app works locally
# with none of this set. Only fill these in if you're swapping to a
# different/commercial provider that requires a key.
# ---------------------------------------------------------------------------

GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=

SOLAR_RESOURCE_PROVIDER=nasa_power
SOLAR_RESOURCE_API_KEY=

WIND_RESOURCE_PROVIDER=nasa_power
WIND_RESOURCE_API_KEY=

WEATHER_PROVIDER=nasa_power
WEATHER_API_KEY=

ELEVATION_PROVIDER=open_elevation
ELEVATION_API_KEY=
